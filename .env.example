# Copy to .env.local for local runs; set the same names in the Vercel project.
# Postgres connection string (added by the Neon Marketplace integration).
DATABASE_URL=
# Vercel Blob read/write token for uploads (added with the Blob store).
BLOB_READ_WRITE_TOKEN=
# The owner's email: can lock, restore and manage editors. Nobody becomes owner through the app.
OWNER_EMAIL=gregory.kurnia@deushcs.com
# Long random string used to hash login codes and session tokens (for example: openssl rand -hex 32).
AUTH_SECRET=
# Resend API key for login-code emails. Leave empty locally to print codes in the terminal.
RESEND_API_KEY=
# Sender shown on login-code emails, for example: DEUS Deck <deck@deushcs.com>
MAIL_FROM=
# The site's public address, used to check the Origin of requests, for example: https://deus-deck.vercel.app
DECK_SITE=
