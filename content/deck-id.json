          {
            "key": "recruitment",
            "title": "Rekrutmen & Program MT",
            "text": "Temukan kandidat yang sesuai dengan perusahaan Anda."
          },
          {
            "key": "mapping",
            "title": "Talent Mapping",
            "text": "Ketahui kelebihan & kekurangan karyawan dalam satu platform."
          },
          {
            "key": "development",
            "title": "Pengembangan Internal",
            "text": "Ketahui apa yang perlu dikembangkan setiap karyawan."
          },
          {
            "key": "promotion",
            "title": "Promosi",
            "text": "Pastikan siapa yang siap mengisi posisi selanjutnya."
          },
          {
            "key": "leadership",
            "title": "Leadership Development",
            "text": "Temukan karyawan yang berpotensi menjadi pemimpin."
          }
        ]
