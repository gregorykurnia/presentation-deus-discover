    {
      "id": "s-problem",
      "layout": "problem",
      "section": "main",
      "hidden": false,
      "fields": {
        "headline": "Pada umumnya, Asesmen hanya menilai kemampuan bekerja seseorang. Namun tidak menilai kesesuaian seseorang dengan perusahaan.",
        "bullets": [
          "Kandidat menghafal jawabannya",
          "Hasilnya tidak dikaitkan dengan peran dan budaya perusahaan Anda",
          "Karyawan yang tidak sesuai, keluar setelah perusahaan berinvestasi kepada mereka"
        ]
      },
      "images": {},
      "notes": "Tanyakan: “Dari batch MT terakhir Anda, berapa orang yang masih bertahan?” Lalu dengarkan."
    },
