    {
      "id": "s-title",
      "layout": "title",
      "section": "main",
      "hidden": false,
      "fields": {
        "headline": "DEUS Game-Based Assessment",
        "subtitle": "Fit the role, they perform. Fit your company, they stay.",
        "preparedFor": "Prepared for: Pizza Hut"
      },
      "images": {
        "logo": {
          "src": "assets/logo-lockup-dark.svg",
          "fit": "contain",
          "focus": [
            50,
            50
          ],
          "label": "DEUS logo"
        },
        "clientLogo": {
          "src": null,
          "fit": "contain",
          "focus": [
            50,
            50
          ],
          "label": "Client logo"
        }
      },
      "notes": "Open with: \"Most tests only check if someone can do the job. We also check if they belong in your company.\""
    },
    {
      "id": "s-problem",
      "layout": "problem",
      "section": "main",
      "hidden": false,
      "fields": {
        "headline": "Today's assessment checks if they can do the job. Not if they'll fit, or stay.",
        "bullets": [
          "Candidates memorize the answers",
          "Results aren't tied to your roles or your culture",
          "Wrong fits leave after you've invested in them"
        ]
      },
      "images": {},
      "notes": "Ask: \"How many of your last MT batch are still with you?\" Then listen."
    },
    {
      "id": "s-fit",
      "layout": "fit",
      "section": "main",
      "hidden": false,
      "fields": {
        "headline": "We score each candidate on job fit and culture fit",
        "roleFit": {
          "title": "Role fit",
          "text": "Can they succeed in this job?"
        },
        "cultureFit": {
          "title": "Culture fit",
          "text": "Do they share your values and way of working?"
        },
        "steps": [
          "Your roles + your values",
          "Success profile",
          "Candidates play",
          "Suitability score"
        ],
        "footer": "Profiles ready in [X] days.",
        "pill": "One score"
      },
      "images": {},
      "notes": "\"Same games, different definition of success. Culture fit means your values written down, not 'people like us.'\""
    },
    {
      "id": "s-video",
      "layout": "video",
      "section": "main",
      "hidden": false,
      "fields": {
        "headline": "From game to fit score in 60 seconds.",
        "linkLine": "Watch the demo: [link]",
        "quote": "Tidak terasa seperti psikotest. Sangat menyenangkan!",
        "quoteBy": "Telkom MT candidate"
      },
      "images": {
        "video": {
          "src": "assets/demo.mp4",
          "label": "Product demo video"
        },
        "poster": {
          "src": "assets/demo-poster.jpg",
          "fit": "cover",
          "focus": [
            50,
            50
          ],
          "label": "Demo video poster"
        },
        "qr": {
          "src": null,
          "fit": "contain",
          "focus": [
            50,
            50
          ],
          "label": "QR code to the demo"
        }
      },
      "notes": "\"While she played the balloon game, it measured how she takes risks and learns from mistakes. That feeds directly into her fit.\""
    },
