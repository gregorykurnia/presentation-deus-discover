{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run export:offline",
  "outputDirectory": "dist/offline",
  "rewrites": [
    { "source": "/", "destination": "/deck.html" },
    { "source": "/discover", "destination": "/deck.html" },
    { "source": "/:path*", "destination": "https://deushr.web.app/:path*" }
  ],
  "redirects": [
    { "source": "/", "has": [{ "type": "host", "value": "deck.deushcs.com" }], "destination": "/about", "permanent": false },
    { "source": "/discover/", "destination": "/discover", "permanent": true }
  ],
  "git": { "deploymentEnabled": { "staging": false, "lane-*": false } }
}
